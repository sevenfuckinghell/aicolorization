# ── ColorRevive configuration ────────────────────────────────────────────────
# Copy to .env (frontend/) and backend/.env as needed. Never commit real secrets.

# Frontend: base URL of the FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend: comma-separated list of allowed CORS origins
API_CORS_ORIGINS=http://localhost:3000

# Path to a trained PyTorch checkpoint. If missing, the app starts in
# clearly-labeled deterministic FALLBACK mode.
MODEL_CHECKPOINT_PATH=./checkpoints/colorization.pt
MODEL_NAME=unet-lab-v1

# auto | cpu | cuda  (cuda is used only when available)
DEVICE=auto

# Safety limits
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=25000000
INFERENCE_TIMEOUT_SECONDS=60

# Behavior flags
ENABLE_FALLBACK_MODE=true
ENABLE_PERSISTENT_STORAGE=false

# Response strategy: base64 (JSON-embedded image) or binary
RESPONSE_MODE=base64

# Logging
LOG_LEVEL=INFO
